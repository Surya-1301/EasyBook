PORT=4000
JWT_SECRET=dev-secret-change-me
NODE_ENV=development

# --- First-time setup: npm run bootstrap ---
# Creates one clinic and its first clinic-admin. No demo data is created.
# BOOTSTRAP_CLINIC_NAME="My Clinic"
# BOOTSTRAP_CLINIC_PHONE="+91..."
# BOOTSTRAP_TIMEZONE="Asia/Kolkata"
# BOOTSTRAP_ADMIN_NAME="Admin Name"
# BOOTSTRAP_ADMIN_EMAIL="admin@myclinic.com"
# BOOTSTRAP_ADMIN_PHONE="+91..."
# BOOTSTRAP_ADMIN_PASSWORD="<at least 8 characters>"

# --- Demo login for local testing: npm run demo-user ---
# Creates/refreshes a staff account for /staff/login (phone + password).
# Defaults: phone 9616398313 / password 123456 / role CLINIC_ADMIN.
# DEMO_PHONE="9616398313"
# DEMO_PASSWORD="123456"
# DEMO_NAME="Demo User"
# DEMO_ROLE="CLINIC_ADMIN"
# DEMO_EMAIL=""
# DEMO_CLINIC_ID=""

# --- Demo patient login (dev only) ---
# On /login, entering DEMO_PHONE + DEMO_PASSWORD as the OTP skips the SMS
# provider. Automatically disabled when NODE_ENV=production.
# DEMO_LOGIN_ENABLED="true"
